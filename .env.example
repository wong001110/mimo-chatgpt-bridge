# Bridge HTTP server
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_DATA_DIR=./data
BRIDGE_LOG_LEVEL=info

# MiMoCode plugin -> local bridge authentication.
# Generate with: npm run token
MIMO_BRIDGE_TOKEN=replace-with-a-long-random-token

# MiMoCode server started by MiMoCode / mimo serve.
MIMO_SERVER_URL=http://127.0.0.1:4096

# Optional: restrict webhook project directories. Separate multiple roots with the OS path delimiter.
# Windows example: D:\\Projects;C:\\Work
# macOS example: /Users/you/Projects:/Users/you/Work
MIMO_ALLOWED_ROOTS=

# MCP endpoint capability token. ChatGPT endpoint becomes:
# https://<your-tunnel-host>/mcp/<this-token>
MCP_PATH_TOKEN=replace-with-a-second-long-random-token

# Comma-separated public tunnel hosts accepted by the bridge.
# Example: random-name.trycloudflare.com
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional static bearer token for MCP clients that support custom headers.
# For ChatGPT "No auth" setup, leave blank and rely on the unguessable MCP path token.
MCP_AUTH_TOKEN=

# desktop: experimental ChatGPT desktop handoff through a localhost review page
# api: OpenAI Responses API reviews and sends follow-up instructions automatically
# hybrid: API performs the automatic loop and ChatGPT desktop receives status prompts
# none: store events only (safe default)
REVIEW_MODE=none
MAX_AUTO_ITERATIONS=3

# Local review page opened by ChatGPT desktop's built-in browser.
# Keep this loopback-only. Change only when the bridge uses a different local port.
BRIDGE_REVIEW_BASE_URL=http://127.0.0.1:8787

# ChatGPT desktop trigger (experimental; disabled by default)
CHATGPT_DESKTOP_ENABLED=false
CHATGPT_DESKTOP_MODE=companion
CHATGPT_APP_NAME=ChatGPT
CHATGPT_AUTO_SUBMIT=true
CHATGPT_OPEN_DELAY_MS=900
CHATGPT_PASTE_DELAY_MS=250

# Optional API reviewer, required for REVIEW_MODE=api or hybrid
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Payload limits
MAX_WEBHOOK_BYTES=1048576
MAX_DIFF_BYTES=200000
MAX_ASSISTANT_TEXT_BYTES=100000
