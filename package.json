{
  "name": "mimo-chatgpt-bridge",
  "version": "0.1.0",
  "description": "Local MiMoCode completion bridge with MCP tools, ChatGPT desktop triggering, and optional OpenAI API review.",
  "type": "module",
  "private": true,
  "bin": {
    "mimo-chatgpt-bridge": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js start",
    "dev": "node --watch src/cli.js start",
    "doctor": "node src/cli.js doctor",
    "plugin:install": "node src/cli.js install-plugin",
    "token": "node scripts/generate-token.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "validate": "npm run check && npm test",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@mimo-ai/sdk": "0.1.9",
    "@modelcontextprotocol/sdk": "1.29.0",
    "openai": "6.48.0",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT"
}
